import "https://kit.edu/vitruvius/case-study/racecar/1.0" as racecar
import "https://kit.edu/vitruvius/case-study/electricalracecar/1.0" as electrical


reactions: electrical2racecar

in reaction to changes in electrical
execute actions in racecar


reaction UpdateRaceCarRatedPower {
    after attribute replaced at
        electrical::ElectricPowertrain[maxPower]

    call updateRaceCarRatedPower(
        affectedEObject
    )
}

routine updateRaceCarRatedPower(
    electrical::ElectricPowertrain electricPowertrain
) {
    match {
        val raceCar =
            retrieve asserted racecar::RaceCar
                corresponding to electricPowertrain
    }

    update {
        if (
            raceCar.ratedPower !=
            electricPowertrain.maxPower
        ) {
            raceCar.ratedPower =
                electricPowertrain.maxPower
        }
    }
}


reaction RecalculateRaceCarMassAfterPowertrainMassChanged {
    after attribute replaced at
        electrical::ElectricPowertrain[mass]

    call recalculateRaceCarTotalMass(
        affectedEObject
    )
}

routine recalculateRaceCarTotalMass(
    electrical::ElectricPowertrain electricPowertrain
) {
    match {
        val raceCar =
            retrieve optional racecar::RaceCar
                corresponding to electricPowertrain
    }

    update {
        if (raceCar.isPresent) {
            val car = raceCar.get

            val chassisMass =
                if (car.chassis === null)
                    0.0
                else
                    car.chassis.mass

            var double wheelsMass = 0.0

            for (axle : car.axles) {
                for (wheel : axle.wheels) {
                    wheelsMass =
                        wheelsMass + wheel.mass
                }
            }

            val calculatedTotalMass =
                chassisMass +
                wheelsMass +
                electricPowertrain.mass

            if (
                car.totalMass !=
                calculatedTotalMass
            ) {
                car.totalMass =
                    calculatedTotalMass
            }
        }
    }
}