import kit.sdq.kastel.vitruvius.casestudy.model.racecar.PropulsionKind

import "https://kit.edu/vitruvius/case-study/racecar/1.0" as racecar
import "https://kit.edu/vitruvius/case-study/electricalracecar/1.0" as electrical


reactions: racecar2electrical

in reaction to changes in racecar
execute actions in electrical


reaction CreateElectricalRaceCar {
    after element racecar::RaceCar inserted as root
    with newValue.propulsionKind == PropulsionKind.ELECTRIC

    call createElectricalRaceCar(newValue)
}

routine createElectricalRaceCar(
    racecar::RaceCar raceCar
) {
    match {
        require absence of electrical::ElectricalRaceCar
            corresponding to raceCar
    }

    create {
        val electricalRaceCar =
            new electrical::ElectricalRaceCar
    }

    update {
        electricalRaceCar.vehicleId =
            raceCar.vehicleId

        persistProjectRelative(
            raceCar,
            electricalRaceCar,
            "models/electrical/" +
                raceCar.vehicleId +
                ".electricalracecar"
        )

        addCorrespondenceBetween(
            raceCar,
            electricalRaceCar
        )
    }
}


reaction UpdateElectricalVehicleId {
    after attribute replaced at racecar::RaceCar[vehicleId]

    call updateElectricalVehicleId(affectedEObject)
}

routine updateElectricalVehicleId(
    racecar::RaceCar raceCar
) {
    match {
        val electricalRaceCar =
            retrieve asserted electrical::ElectricalRaceCar
                corresponding to raceCar
    }

    update {
        if (
            electricalRaceCar.vehicleId !=
            raceCar.vehicleId
        ) {
            electricalRaceCar.vehicleId =
                raceCar.vehicleId
        }
    }
}


reaction UpdateElectricalRatedPower {
    after attribute replaced at racecar::RaceCar[ratedPower]

    call updateElectricalRatedPower(
        affectedEObject
    )
}

routine updateElectricalRatedPower(
    racecar::RaceCar raceCar
) {
    match {
        val electricPowertrain =
            retrieve optional electrical::ElectricPowertrain
                corresponding to raceCar
    }

    update {
        if (electricPowertrain.isPresent) {
            val powertrain = electricPowertrain.get

            if (powertrain.maxPower != raceCar.ratedPower) {
                powertrain.maxPower = raceCar.ratedPower
            }
        }
    }
}


reaction UpdateElectricalMountInterface {

    after attribute replaced at
        racecar::PowertrainSlot[mountInterface]

    call updateElectricalMountInterface(
        affectedEObject
    )
}

routine updateElectricalMountInterface(
    racecar::PowertrainSlot powertrainSlot
) {
    match {
        val electricPowertrain =
            retrieve optional electrical::ElectricPowertrain
                corresponding to powertrainSlot
    }

    update {
        if (electricPowertrain.isPresent) {
            val powertrain = electricPowertrain.get

            if (
                powertrain.mountInterface !=
                powertrainSlot.mountInterface
            ) {
                powertrain.mountInterface =
                    powertrainSlot.mountInterface
            }
        }
    }
}


reaction DeleteElectricalRaceCar {
    after element racecar::RaceCar removed as root

    call deleteElectricalRaceCar(
        oldValue
    )
}

routine deleteElectricalRaceCar(
    racecar::RaceCar raceCar
) {
    match {
        val electricalRaceCar =
            retrieve optional electrical::ElectricalRaceCar
                corresponding to raceCar

        val electricPowertrain =
            retrieve optional electrical::ElectricPowertrain
                corresponding to raceCar
    }

    update {
        if (electricPowertrain.isPresent) {
            val powertrain =
                electricPowertrain.get

            removeCorrespondenceBetween(
                raceCar,
                powertrain
            )
        }

        if (electricalRaceCar.isPresent) {
            val electricalCar =
                electricalRaceCar.get

            removeCorrespondenceBetween(
                raceCar,
                electricalCar
            )

            removeObject(
                electricalCar
            )
        }
    }
}


reaction CreateElectricPowertrain {
    after element racecar::PowertrainSlot
        replaced at racecar::RaceCar[powertrainSlot]

    with newValue !== null &&
         newValue.requiredType == PropulsionKind.ELECTRIC

    call createElectricPowertrain(
        affectedEObject,
        newValue
    )
}

routine createElectricPowertrain(
    racecar::RaceCar raceCar,
    racecar::PowertrainSlot powertrainSlot
) {
    match {
        val electricalRaceCar =
            retrieve asserted electrical::ElectricalRaceCar
                corresponding to raceCar

        require absence of electrical::ElectricPowertrain
            corresponding to powertrainSlot
    }

    create {
        val electricPowertrain =
            new electrical::ElectricPowertrain

        val battery =
            new electrical::Battery

        val motor =
            new electrical::ElectricMotor

        val inverter =
            new electrical::Inverter
    }

    update {
        electricalRaceCar.powertrain =
            electricPowertrain

        addCorrespondenceBetween(
            powertrainSlot,
            electricPowertrain
        )

        addCorrespondenceBetween(
            raceCar,
            electricPowertrain
        )

        electricPowertrain.mountInterface =
            powertrainSlot.mountInterface

        electricPowertrain.maxPower =
            raceCar.ratedPower

        electricPowertrain.battery =
            battery

        electricPowertrain.motor =
            motor

        electricPowertrain.inverter =
            inverter
    }
}


reaction DeleteElectricPowertrain {
    after element racecar::PowertrainSlot
        replaced at racecar::RaceCar[powertrainSlot]

    with oldValue !== null &&
         newValue === null

    call deleteElectricPowertrain(
        affectedEObject,
        oldValue
    )
}

routine deleteElectricPowertrain(
    racecar::RaceCar raceCar,
    racecar::PowertrainSlot oldPowertrainSlot
) {
    match {
        val electricPowertrain =
            retrieve optional electrical::ElectricPowertrain
                corresponding to oldPowertrainSlot
    }

    update {
        if (electricPowertrain.isPresent) {
            val powertrain =
                electricPowertrain.get

            removeCorrespondenceBetween(
                oldPowertrainSlot,
                powertrain
            )

            removeCorrespondenceBetween(
                raceCar,
                powertrain
            )

            removeObject(
                powertrain
            )
        }
    }
}