import kit.sdq.kastel.vitruvius.casestudy.model.racecar.PropulsionKind

import "https://kit.edu/vitruvius/case-study/racecar/1.0" as racecar
import "https://kit.edu/vitruvius/case-study/electricalracecar/1.0" as electrical


reactions: racecar2electrical

in reaction to changes in racecar
execute actions in electrical


reaction CreateElectricalRaceCar {
    after element racecar::RaceCar inserted as root
    with newValue.propulsionKind == PropulsionKind.ELECTRIC

    call createElectricalRaceCar(newValue)
}


routine createElectricalRaceCar(racecar::RaceCar raceCar) {

    match {
        require absence of electrical::ElectricalRaceCar corresponding to raceCar
    }

    create {
        val electricalRaceCar = new electrical::ElectricalRaceCar
    }

    update {
        electricalRaceCar.vehicleId = raceCar.vehicleId

        addCorrespondenceBetween(
            electricalRaceCar,
            raceCar
        )
    }
}