import kit.sdq.kastel.vitruvius.casestudy.model.racecar.PropulsionKind

import "https://kit.edu/vitruvius/case-study/racecar/1.0" as racecar
import "https://kit.edu/vitruvius/case-study/electricalracecar/1.0" as electrical


reactions: racecar2electrical

in reaction to changes in racecar
execute actions in electrical


reaction CreateElectricalRaceCar {
    after element racecar::RaceCar inserted as root
    with newValue.propulsionKind == PropulsionKind.ELECTRIC

    call createElectricalRaceCar(newValue)
}


routine createElectricalRaceCar(racecar::RaceCar raceCar) {

    match {
        require absence of electrical::ElectricalRaceCar
            corresponding to raceCar
    }

    create {
        val electricalRaceCar =
            new electrical::ElectricalRaceCar

        val electricPowertrain =
            new electrical::ElectricPowertrain

        val battery =
            new electrical::Battery

        val motor =
            new electrical::ElectricMotor

        val inverter =
            new electrical::Inverter
    }

    update {
        electricalRaceCar.vehicleId = raceCar.vehicleId
        electricPowertrain.maxPower = raceCar.ratedPower

        if (raceCar.powertrainSlot !== null) {
            electricPowertrain.mountInterface =
                raceCar.powertrainSlot.mountInterface
        }

        electricPowertrain.battery = battery
        electricPowertrain.motor = motor
        electricPowertrain.inverter = inverter

        electricalRaceCar.powertrain = electricPowertrain

        persistProjectRelative(
            raceCar,
            electricalRaceCar,
            "models/electrical/" +
                raceCar.vehicleId +
                ".electricalracecar"
        )

        addCorrespondenceBetween(
            raceCar,
            electricalRaceCar
        )
    }
}